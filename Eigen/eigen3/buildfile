# Eigen's Core Headers
#
# Eigen uses headers with and without extensions and we must match both groups.
#
lib{Eigen}: Eigen/{hxx ixx}{**} Eigen/hxx{**.}

# Eigen's Unsupported Module Headers
#
# Eigen is header-only, so we treat every header as part of the library's
# source, the unsupported modules included. This keeps the build simple and
# has no effect on users unless they explicitly include an unsupported module.
#
lib{Eigen}: unsupported/Eigen/{hxx ixx}{**} unsupported/Eigen/hxx{**.}

# Build and Export Options: Include Paths
#
# Eigen's design allows headers to be included in two ways, for example:
#
#   #include <Eigen/Splines>
#   #include <unsupported/Eigen/Splines>
#
# We expose both search paths to ourselves and to dependents,
# listing the core path first so it takes precedence.
#
poptions = "-I$src_base" "-I$src_base/unsupported"
cxx.poptions =+ $poptions
lib{Eigen}: cxx.export.poptions = $poptions

# Installation
#
# Preserve the same two include paths, in the same priority order, after
# installation by emitting them into the generated pkg-config (.pc) file.
#
lib{Eigen}: cxx.pkgconfig.include = include/eigen3/ include/eigen3/unsupported/
#
{hxx ixx}{*}:
{
  install         = include/eigen3/
  install.subdirs = true
}
