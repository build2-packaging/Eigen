# Eigen's Core Headers
#
# Eigen uses files with and without extensions for its headers.
# So, we must add patterns to match both conventions.
#
lib{Eigen}: Eigen/{hxx ixx}{**} Eigen/hxx{**.}

# Eigen's Unsupported Module Headers
#
# Since Eigen is a header-only library, we consider
# all headers part of the library's source files.
# This greatly simplifies the build system.
# Users are unaffected unless they specifically
# include Eigen's unsupported module headers.
#
lib{Eigen}: unsupported/Eigen/{hxx ixx}{**} unsupported/Eigen/hxx{**.}

# Build and Export Options: Include Paths
#
# Eigen's design allows headers to be included in two ways, for example:
#   #include <Eigen/Splines>
#   #include <unsupported/Eigen/Splines>
#
# We have to reflect this in the package's source layout and
# provide both include paths to users of the library target.
# We prioritize Eigen's core headers by listing them first.
#
poptions = "-I$src_base" "-I$src_base/unsupported"
cxx.poptions =+ $poptions
lib{Eigen}: cxx.export.poptions = $poptions

# Installation
#
# The include path configuration must be preserved upon installation.
# The generated pkg-config file (.pc) is configured to provide both
# include paths, maintaining the same priority order defined above.
#
lib{Eigen}: cxx.pkgconfig.include = include/eigen3/ include/eigen3/unsupported/
#
{hxx ixx}{*}:
{
  install         = include/eigen3/
  install.subdirs = true
}
